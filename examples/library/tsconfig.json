{
  "extends": "@gravity-ui/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "rootDir": "src",
    "noEmit": false,
    "noErrorTruncation": true
  },
  "include": ["src/**/*"]
}
